APP_NAME=pisau-pedia-backend
APP_PORT=8080
APP_ENV=development
APP_DEBUG=true

DB_HOST=mysql
DB_PORT=3306
DB_USER=pisaupedia
DB_PASSWORD=pisaupedia_secret_change_me
DB_ROOT_PASSWORD=root_secret_change_me
DB_NAME=pisau_pedia
DB_PARAMS=parseTime=true&charset=utf8mb4&loc=Local

JWT_SECRET=change-this-to-a-random-string-at-least-32-bytes-long
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_HOURS=168

FRONTEND_URL=http://localhost:3000

# RajaOngkir (Komerce) — Shipping Cost API. Get a key at rajaongkir.com.
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_ID=

# Komerce Payment Service. Use the sandbox base for test keys.
KOMERCE_PAYMENT_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
KOMERCE_PAYMENT_API_KEY=
KOMERCE_PAYMENT_CALLBACK_KEY=

# Komerce QRISLY (dynamic QRIS). KOMERCE_QRISLY_ID is the qris_id from upload-qris.
KOMERCE_QRISLY_BASE_URL=https://api-sandbox.collaborator.komerce.id/user
KOMERCE_QRISLY_API_KEY=
KOMERCE_QRISLY_CALLBACK_KEY=
KOMERCE_QRISLY_ID=
